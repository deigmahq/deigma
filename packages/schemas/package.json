{
  "name": "@mentat/schemas",
  "version": "0.1.0",
  "private": true,
  "description": "Single source of wire types: zod schemas (envelope 2.0, payloads, episodes, snapshots) with JSON Schema export for the Python stack",
  "type": "module",
  "sideEffects": [
    "./src/export-json-schema.ts"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./traffic-audit.json": "./traffic-audit.json"
  },
  "files": [
    "src",
    "json"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "tsx src/export-json-schema.ts",
    "test": "vitest run",
    "gen-traffic-audit": "tsx scripts/gen-traffic-audit.ts"
  },
  "dependencies": {
    "zod": "4.4.3"
  }
}
